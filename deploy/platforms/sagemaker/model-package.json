{
  "ModelPackageName": "arc-tagger",
  "ModelPackageDescription": "Arc Tagger: streaming text tagger for entities, numbers, PII, safety, intent, dialogue act and affect (CPU).",
  "CertifyForMarketplace": true,
  "InferenceSpecification": {
    "Containers": [
      {"Image": "<account>.dkr.ecr.<region>.amazonaws.com/arc-tagger:0.1.0-v0.4.1", "Environment": {"ARCTAG_WORKERS": "2"}}
    ],
    "SupportedContentTypes": ["application/json", "application/jsonlines", "text/plain"],
    "SupportedResponseMIMETypes": ["application/json", "application/jsonlines"],
    "SupportedRealtimeInferenceInstanceTypes": ["ml.c6i.large", "ml.c6i.xlarge", "ml.c6i.2xlarge", "ml.m6i.large", "ml.m6i.xlarge"],
    "SupportedTransformInstanceTypes": ["ml.c6i.large", "ml.c6i.xlarge", "ml.c6i.2xlarge", "ml.m6i.xlarge"]
  },
  "ValidationSpecification": {
    "ValidationRole": "arn:aws:iam::<account>:role/<sagemaker-role>",
    "ValidationProfiles": [
      {
        "ProfileName": "sample-texts",
        "TransformJobDefinition": {
          "TransformInput": {
            "DataSource": {"S3DataSource": {"S3DataType": "S3Prefix", "S3Uri": "s3://<bucket>/arc-tagger/validation/"}},
            "ContentType": "application/jsonlines",
            "SplitType": "Line"
          },
          "TransformOutput": {"S3OutputPath": "s3://<bucket>/arc-tagger/validation-out/", "Accept": "application/jsonlines", "AssembleWith": "Line"},
          "TransformResources": {"InstanceType": "ml.c6i.large", "InstanceCount": 1},
          "BatchStrategy": "MultiRecord",
          "MaxPayloadInMB": 6
        }
      }
    ]
  }
}
